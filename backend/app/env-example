 # To re-enable, add an "audience" protocol mapper in Keycloak for mcp_server.
 KEYCLOAK_VERIFY_AUD=true
# Set to false to disable SSL certificate verification in dev environments with self-signed HTTPS certs
KEYCLOAK_VERIFY_SSL=true

 
 
 
