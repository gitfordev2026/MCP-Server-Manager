 #------------keycloak------------
 # Toggle auth
# AUTH_ENABLED=false
AUTH_ENABLED=true
 

MCP_MANAGER_NAME="MCP SERVER MANAGER(Combined)"

MCP_USE_ANONYMIZED_TELEMETRY=false

# Keycloak server + realm
KEYCLOAK_SERVER_URL=http://127.0.0.1:8080
KEYCLOAK_FRONTEND_URL=http://localhost:8080
KEYCLOAK_REALM=mcp-realm
KEYCLOAK_CLIENT_ID=mcp_server1

 
