# =================================================================
# Mock MCP Server Environment Configuration Example
# Copy this file to .env: cp .env.example .env
# =================================================================

# -----------------------------------------------------------------
# Shared Keycloak Settings (mcp-realm)
# -----------------------------------------------------------------
KEYCLOAK_SERVER_URL=http://host.docker.internal:8080
KEYCLOAK_REALM=mcp-realm
REQUIRE_AUTH=true
ENV=development

# -----------------------------------------------------------------
# 1. Main Mock MCP Server (Port 8001)
# -----------------------------------------------------------------
KEYCLOAK_CLIENT_ID=mock-server-client
KEYCLOAK_CLIENT_SECRET=
MAIN_MOCK_PORT=8001

# -----------------------------------------------------------------
# 2. Inventory & Supply Chain API (Port 8002) — Confidential Client
# -----------------------------------------------------------------
INVENTORY_KEYCLOAK_CLIENT_ID=adm-client
INVENTORY_KEYCLOAK_CLIENT_SECRET=adm-secret
INVENTORY_PORT=8002

# -----------------------------------------------------------------
# 3. Customer Portal API (Port 8003) — Public Client
# -----------------------------------------------------------------
PORTAL_KEYCLOAK_CLIENT_ID=mcp-client
PORTAL_PORT=8003

# -----------------------------------------------------------------
# 4. Analytics & Reporting API (Port 8004) — Confidential Client
# -----------------------------------------------------------------
ANALYTICS_KEYCLOAK_CLIENT_ID=ops-client
ANALYTICS_KEYCLOAK_CLIENT_SECRET=ops-secret
ANALYTICS_PORT=8004
